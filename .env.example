# Snowball configuration. Copy to .env and adjust.
# Default config is PAPER ONLY and cannot send live Coinbase orders.

# --- Mode (live requires BOTH of these) ---
# paper | live
MODE=paper
# Must be true AND MODE=live to place real orders. Default false.
LIVE_ENABLED=false

# Soft kill: false keeps the process up and logging, places zero orders.
TRADING_ENABLED=true
# Kill switch file. `touch HALT` to stop orders; delete it to resume.
HALT_FILE=./HALT

# --- Venue ---
EXCHANGE_ID=coinbase
# Coinbase Advanced Trade products (ccxt id: coinbase)
PRODUCTS=BTC-USD,SOL-USD,ETH-USD,DOGE-USD
TIMEFRAME=15m

# --- Strategies (long-only SMA crossover, paper) ---
# Comma list. Known: sma_15m, sma_5m. Unknown names abort at startup.
# Default enables both. 15m-only: STRATEGIES=sma_15m
STRATEGIES=sma_15m,sma_5m
SMA_FAST=20
SMA_SLOW=50

# --- Risk ---
BANKROLL_USD=1000
# Max open lots on each pair (BTC/SOL/ETH/DOGE). Book max = 5*4 = 20.
MAX_POSITIONS_PER_PAIR=5
# Per-lot notional cap (USD). Size still capped by bankroll / available USD.
MAX_POSITION_NOTIONAL_USD=100
# Flatten + block new entries for the rest of the UTC day if realized+unrealized PnL <= -this.
DAILY_LOSS_KILL_USD=25
# Seconds between entries on the same pair+strategy (sma_15m = one 15m candle).
ENTRY_COOLDOWN_SECONDS=900
# sma_5m cooldown (one 5-minute candle). Independent of the 15m cooldown.
ENTRY_COOLDOWN_5M_SECONDS=300
# Scale-in: second lot only if open lots for that strategy are green by this fraction of entry (0.005 = 0.5%).
SCALE_IN_MIN_PROFIT_PCT=0.005
# Strategy exits (sma_15m and sma_5m): only take profit at this unrealized return (0.05 = 5%).
# Never sell red on strategy logic. Death cross alone does not exit; green >=5% exits with or without it.
# HALT / daily-loss kill still flatten including losers (emergency).
MIN_TAKE_PROFIT_PCT=0.05
NEVER_SELL_RED=true
# Trend filter: require last > SMA slow before any NEW entry or scale-in. Missing SMA slow blocks.
TREND_FILTER_ENABLED=true
# Per-product pause after N consecutive closed losing trades (exits still allowed).
PAIR_PAUSE_ENABLED=true
PAIR_PAUSE_LOSSES=3
PAIR_PAUSE_HOURS=24
# Optional: write product ids (comma or newline) then the engine clears pauses and deletes the file.
# PAIR_PAUSE_CLEAR_FILE=./PAIR_PAUSE_CLEAR
# Paper fill: last/mid * (1 +/- bps/10000)
SLIPPAGE_BPS=5
TAKER_FEE_BPS=0

# --- Persistence / loop ---
SQLITE_PATH=./data/snowball.db
HEARTBEAT_PATH=./data/heartbeat
POLL_SECONDS=15
# Must be >= SMA_SLOW+1 (51) so both 5m and 15m have enough bars.
OHLCV_LIMIT=80
LOG_LEVEL=INFO

# --- Dashboard (LAN only, no auth) ---
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- The Watcher (official macro research sidecar; never places orders) ---
WATCHER_ENABLED=true
WATCHER_POLL_SECONDS=300
# Optional. From https://developer.tradingeconomics.com — leave empty to skip TE.
TRADINGECONOMICS_API_KEY=
# Optional. From https://fred.stlouisfed.org/docs/api/api_key.html — leave empty to skip FRED.
FRED_API_KEY=
# Auto-HALT around high-importance FOMC/rate-decision windows. Default off (dashboard Halt is enough).
WATCHER_HALT_AROUND_FOMC=false
WATCHER_HALT_MINUTES_BEFORE=30
WATCHER_HALT_MINUTES_AFTER=15

# --- Yolo Demon (HIGH RISK / RESEARCH ONLY / DOES NOT TRADE) ---
# Sources: YouTube Data API v3 + X API v2 (StockTwits dropped — no API keys issued).
# Never places orders / writes HALT.
YOLO_DEMON_ENABLED=true
YOLO_DEMON_POLL_SECONDS=120
# YouTube Data API v3: Google Cloud → enable YouTube Data API v3 → API key.
YOUTUBE_API_KEY=
# Prefer these channels (comma-separated handles). Skips noisy global search when set.
YOUTUBE_CHANNEL_HANDLES=thetradingfraternity,thestockmarket
# Keyword search fallback (100 quota units/search). Default false when handles are set.
YOUTUBE_ALLOW_KEYWORD_SEARCH=false
# Priority channel recent page size (uploads playlistItems ≈1 quota unit/call).
YOUTUBE_PRIORITY_MAX_RESULTS=20
# One-shot backfill every upload since this ISO time (playlist walk). Empty = skip.
# Meta flag prevents re-walk; sidecar does this automatically on first poll.
YOLO_YOUTUBE_BACKFILL_SINCE=2026-01-01T00:00:00Z
# X / Twitter API v2 bearer. PAY-PER-USE (~$0.005/post read). Default OFF even with token.
X_BEARER_TOKEN=
X_ENABLED=false
X_DAILY_MAX_READS=50

# --- The Clerk (House Clerk PTR research; NEVER places orders / writes HALT) ---
# Official source only: disclosures-clerk.house.gov financial-pdfs + ptr-pdfs.
# Does not use Senate eFD, Capitol Trades, Quiver, or house-stock-watcher.
CLERK_ENABLED=true
# Minimum poll interval is 6h (21600). Once per day is the design intent.
CLERK_POLL_SECONDS=21600
CLERK_SQLITE_PATH=./data/snowball_clerk.db
# New electronic PTR PDFs per poll (watchlist first). Scanned DocIDs 8/9 are logged, not downloaded.
CLERK_PDF_CAP=25
CLERK_PDF_DELAY_SECONDS=0.75
# Empty = current calendar year and prior year. Example: 2026
CLERK_YEARS=


# --- STOCK PAPER lane (isolated book; NEVER live equity orders this week) ---
STOCK_ENABLED=true
STOCK_MODE=paper
STOCK_SQLITE_PATH=./data/snowball_stocks.db
STOCK_BANKROLL_USD=1000
STOCK_MAX_POSITIONS=5
STOCK_MAX_NOTIONAL_USD=100
STOCK_DAILY_LOSS_KILL_USD=25
STOCK_STRATEGIES=sma_15m,sma_5m,sma_1d,ema_15m,donchian_1d
STOCK_POLL_SECONDS=60
# Max symbols the paper engine may trade (universe/marks may be larger)
STOCK_MAX_ACTIVE=60
# Max Yolo Demon dynamic equity tickers overlaid onto the static HOT list
STOCK_DYNAMIC_MAX=30
ENTRY_COOLDOWN_1D_SECONDS=86400

# --- Live keys (ignored in paper). Trade permission, NO withdraw, IP restrict. ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=
