# Snowball configuration. Copy to .env and adjust.
# Default config is PAPER ONLY and cannot send live Coinbase orders.

# --- Mode (live requires BOTH of these) ---
# paper | live
MODE=paper
# Must be true AND MODE=live to place real orders. Default false.
LIVE_ENABLED=false

# Soft kill: false keeps the process up and logging, places zero orders.
TRADING_ENABLED=true
# Kill switch file. `touch HALT` to stop orders; delete it to resume.
HALT_FILE=./HALT

# --- Venue ---
EXCHANGE_ID=coinbase
# Coinbase Advanced Trade products (ccxt id: coinbase)
PRODUCTS=BTC-USD,SOL-USD,ETH-USD,DOGE-USD
TIMEFRAME=15m

# --- Strategies (long-only SMA crossover, paper) ---
# Comma list. Known include sma_*, ema_15m, donchian_1d, rsi_15m, rsi_1d, bb_15m, bb_1d, session_day.
# Crypto live: SMA + RSI/BB. Futures stays session_day only.
STRATEGIES=sma_15m,sma_5m,rsi_15m,bb_15m,rsi_1d,bb_1d
SMA_FAST=20
SMA_SLOW=50

# --- Risk / capital split (of total Coinbase account value) ---
# Crypto 40% | Stock 40% | Futures 20%. Recomputed each tick/session.
# --- Risk ---
BANKROLL_USD=1000
# Max open lots on each pair (BTC/SOL/ETH/DOGE). Book max = 5*4 = 20.
MAX_POSITIONS_PER_PAIR=5
# Per-lot notional cap (USD). Size still capped by bankroll / available USD.
MAX_POSITION_NOTIONAL_USD=100
# Shared per-leg autoscale (all lanes). per_leg = max(BASE, BASE*(1+(PCT/100)*floor(AV/100)))
PER_LEG_BASE_USD=100
PER_LEG_SCALE_PER_100_USD_PCT=1
PER_LEG_AUTOSCALE=true
# Max fraction of total Coinbase account value crypto may deploy (open notional).
# With CRYPTO_STOCK_SHARED_BUDGET=true, crypto+stock share AV*(crypto+stock) (~65%).
CRYPTO_ACCOUNT_BUDGET_PCT=0.40
CRYPTO_STOCK_SHARED_BUDGET=true
# Flatten + block new entries for the rest of the UTC day if realized+unrealized PnL <= -this.
DAILY_LOSS_KILL_USD=25
# Seconds between entries on the same pair+strategy (sma_15m = one 15m candle).
ENTRY_COOLDOWN_SECONDS=900
# sma_5m cooldown (one 5-minute candle). Independent of the 15m cooldown.
ENTRY_COOLDOWN_5M_SECONDS=300
# Scale-in: second lot only if open lots for that strategy are green by this fraction of entry (0.005 = 0.5%).
SCALE_IN_MIN_PROFIT_PCT=0.005
# Strategy exits (sma_15m and sma_5m): only take profit at this unrealized return (0.05 = 5%).
# Never sell red on strategy logic. Death cross alone does not exit; green >=5% exits with or without it.
# HALT / daily-loss kill still flatten including losers (emergency).
MIN_TAKE_PROFIT_PCT=0.06
# SMA strategies (sma_5m / sma_15m / sma_1d): higher floor before strategy/fade exits.
# Effective ≈ SMA_MIN_TAKE_PROFIT_PCT + FEE_BUFFER_PCT (0.08+0.01 = 9%).
SMA_MIN_TAKE_PROFIT_PCT=0.08
# Round-trip fee estimate (~1%). strategy_exit_allowed requires mark>=entry*(1+MIN_TP+FEE_BUFFER)
# so a “6% green” that would be red after fees is refused (effective floor ≈ 7% non-SMA).
FEE_BUFFER_PCT=0.01
# Maker-limit entry/exit settle timeout (seconds). Unfilled limits are canceled (no fake fills).
MAKER_TIMEOUT_SECONDS=90
NEVER_SELL_RED=true
# Trend filter: require last > SMA slow before any NEW entry or scale-in. Missing SMA slow blocks.
TREND_FILTER_ENABLED=true
INDICATOR_FILTERS_ENABLED=true
RSI_PERIOD=14
BB_PERIOD=20
BB_STD_MULT=2.0
# Per-product pause after N consecutive closed losing trades (exits still allowed).
PAIR_PAUSE_ENABLED=true
PAIR_PAUSE_LOSSES=3
PAIR_PAUSE_HOURS=24
# Optional: write product ids (comma or newline) then the engine clears pauses and deletes the file.
# PAIR_PAUSE_CLEAR_FILE=./PAIR_PAUSE_CLEAR
# Paper fill: last/mid * (1 +/- bps/10000)
SLIPPAGE_BPS=5
TAKER_FEE_BPS=0

# --- Persistence / loop ---
SQLITE_PATH=./data/snowball.db
HEARTBEAT_PATH=./data/heartbeat
POLL_SECONDS=15
# Must be >= SMA_SLOW+1 (51) so both 5m and 15m have enough bars.
OHLCV_LIMIT=80
LOG_LEVEL=INFO

# --- Dashboard (LAN only, no auth) ---
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- The Watcher (official macro research sidecar; never places orders) ---
WATCHER_ENABLED=true
WATCHER_POLL_SECONDS=300
# Optional. From https://developer.tradingeconomics.com — leave empty to skip TE.
TRADINGECONOMICS_API_KEY=
# Optional. From https://fred.stlouisfed.org/docs/api/api_key.html — leave empty to skip FRED.
FRED_API_KEY=
# Auto-HALT around high-importance FOMC/rate-decision windows. Default off (dashboard Halt is enough).
WATCHER_HALT_AROUND_FOMC=false
WATCHER_HALT_MINUTES_BEFORE=30
WATCHER_HALT_MINUTES_AFTER=15

# --- Yolo Demon (HIGH RISK / RESEARCH ONLY / DOES NOT TRADE) ---
# Sources: YouTube Data API v3 + X API v2 (StockTwits dropped — no API keys issued).
# Never places orders / writes HALT.
YOLO_DEMON_ENABLED=true
YOLO_DEMON_POLL_SECONDS=120
# YouTube Data API v3: Google Cloud → enable YouTube Data API v3 → API key.
YOUTUBE_API_KEY=
# Prefer these channels (comma-separated handles). Skips noisy global search when set.
YOUTUBE_CHANNEL_HANDLES=thetradingfraternity,thestockmarket,elliotrades_official
# Keyword search fallback (100 quota units/search). Default false when handles are set.
YOUTUBE_ALLOW_KEYWORD_SEARCH=false
# Priority channel recent page size (uploads playlistItems ≈1 quota unit/call).
YOUTUBE_PRIORITY_MAX_RESULTS=20
# One-shot backfill every upload since this ISO time (playlist walk). Empty = skip.
# Per-handle meta tracks completion for this since; new handles backfill without --force.
YOLO_YOUTUBE_BACKFILL_SINCE=2026-01-01T00:00:00Z
# X / Twitter API v2 bearer. PAY-PER-USE (~$0.005/post read). Default OFF even with token.
X_BEARER_TOKEN=
X_ENABLED=false
X_DAILY_MAX_READS=50

# --- The Clerk (House Clerk PTR research; NEVER places orders / writes HALT) ---
# Official source only: disclosures-clerk.house.gov financial-pdfs + ptr-pdfs.
# Does not use Senate eFD, Capitol Trades, Quiver, or house-stock-watcher.
CLERK_ENABLED=true
# Minimum poll interval is 6h (21600). Once per day is the design intent.
CLERK_POLL_SECONDS=21600
CLERK_SQLITE_PATH=./data/snowball_clerk.db
# New electronic PTR PDFs per poll (watchlist first). Scanned DocIDs 8/9 are logged, not downloaded.
CLERK_PDF_CAP=25
CLERK_PDF_DELAY_SECONDS=0.75
# Empty = current calendar year and prior year. Example: 2026
CLERK_YEARS=


# --- Earnings Scout (Nasdaq calendar research; NEVER places orders / writes HALT) ---
# Polls api.nasdaq.com earnings calendar + Yahoo chart v8 for momentum/reaction.
# Heuristic pre_momentum labels are research-only and never order signals.
EARNINGS_ENABLED=true
# Default 4h (14400). Floor 3h / ceiling 6h in the sidecar.
EARNINGS_POLL_SECONDS=14400
EARNINGS_SQLITE_PATH=./data/snowball_earnings.db

# --- STOCK lane (isolated book; live = CFM US5/TEK index products) ---
# Live stock uses CFM CDE US5-19DEC30-CDE + TEK-19DEC30-CDE (same path as FT/Crash/Fed).
# Do NOT place single-name *-PERP-INTX for stock live. Broader names = paper/research only.
# Live requires BOTH STOCK_MODE=live AND STOCK_LIVE_ENABLED=true.
STOCK_ENABLED=true
STOCK_MODE=paper
STOCK_LIVE_ENABLED=false
STOCK_SQLITE_PATH=./data/snowball_stocks.db
STOCK_BANKROLL_USD=1000
# Live CFM: 1 lot per index (aligned with CFM_MAX_CONTRACTS)
STOCK_MAX_POSITIONS=1
# Floor for CFM 1-contract sizing (INTX-era $100 soft cap must not zero contracts)
STOCK_MAX_NOTIONAL_USD=4000
STOCK_DAILY_LOSS_KILL_USD=25
# Fraction of total Coinbase account value stock lane may use (long-only CFM, lev=1).
# Shared pool with crypto when CRYPTO_STOCK_SHARED_BUDGET=true (default).
STOCK_ACCOUNT_BUDGET_PCT=0.25
STOCK_PRODUCTS=US5-19DEC30-CDE,TEK-19DEC30-CDE
STOCK_STRATEGIES=sma_15m,sma_5m,sma_1d,ema_15m,donchian_1d,rsi_15m,bb_15m,rsi_1d,bb_1d
STOCK_POLL_SECONDS=60
# Max symbols for paper/research universe (live orders only on STOCK_PRODUCTS)
STOCK_MAX_ACTIVE=60
# Max Yolo Demon dynamic equity tickers overlaid onto the static HOT list
STOCK_DYNAMIC_MAX=30
# CFM-only: early intraday bank when >=5% green AND 15m price stalled (not trending).
# Trending holds for strategy fade; swing floors (~7%/9%) unchanged for non-stall exits.
STOCK_CFM_STALL_EXIT_ENABLED=true
STOCK_CFM_STALL_EXIT_PCT=0.05
STOCK_CFM_STALL_LOOKBACK_BARS=5
STOCK_CFM_STALL_NEW_HIGH_TOL=0.002
STOCK_CFM_STALL_RANGE_COMPRESS_PCT=0.006
STOCK_CFM_STALL_START_ET=09:30
STOCK_CFM_STALL_END_ET=15:45
ENTRY_COOLDOWN_1D_SECONDS=86400


# --- Future Trader (Coinbase equity perps; session day-trade; dual-gated live) ---
# Products: US5-19DEC30-CDE (US 500 PERP), TEK-19DEC30-CDE (TECH PERP) on CFM/CDE
# CFM_MAX_CONTRACTS=1  CFM_LEVERAGE=1  CFM_MARGIN_RATE=0.10
# Lane MAX_NOTIONAL floors CFM budget so per-leg ~$118 cannot yield contracts=0.
# Live requires BOTH FUTURES_MODE=live AND FUTURES_LIVE_ENABLED=true.
FUTURES_ENABLED=true
FUTURES_MODE=paper
FUTURES_LIVE_ENABLED=false
FUTURES_SQLITE_PATH=./data/snowball_futures.db
FUTURES_BANKROLL_USD=1000
FUTURES_MAX_POSITIONS=1
FUTURES_MAX_NOTIONAL_USD=4000
FUTURES_DAILY_LOSS_KILL_USD=25
# Max fraction of total Coinbase account value FT may use (50/50 across products)
FUTURES_ACCOUNT_BUDGET_PCT=0.30
# session_day = overnight roll; momentum_15m = intraday impulse (shared FT budget ~30%)
# Legacy also parseable: sma_1d,donchian_1d
FUTURES_STRATEGIES=session_day,momentum_15m
FUTURES_PRODUCTS=US5-19DEC30-CDE,TEK-19DEC30-CDE
FUTURES_POLL_SECONDS=60
# America/New_York windows. Entry preferred 09:25-09:30; late catch-up until exit.
FUTURES_ENTRY_START_ET=09:25
FUTURES_ENTRY_END_ET=09:30
FUTURES_EXIT_START_ET=15:55
FUTURES_EXIT_END_ET=16:00
# Intraday momentum (active when momentum_15m in FUTURES_STRATEGIES)
FUTURES_MOMENTUM_TIMEFRAME=15m
FUTURES_MOMENTUM_LOOKBACK_BARS=8
FUTURES_MOMENTUM_MIN_PCT=0.003
FUTURES_MOMENTUM_TAKE_PROFIT_PCT=0.008
FUTURES_MOMENTUM_STALL_EXIT_ENABLED=true
FUTURES_MOMENTUM_STALL_LOOKBACK_BARS=4
FUTURES_MOMENTUM_STALL_EXIT_PCT=0.004
# Aspirational KPI for logs/PDF only — does not override risk gates / CFM_MAX_CONTRACTS
FUTURES_DAILY_PNL_TARGET_USD=100


# --- Crash Guard (short hedge on CFM US500/TECH; dual-gated live) ---
# Isolated ledger data/snowball_crash.db. Max 1 short/index. Leverage 1x.
# Enter on daily dump ≤−2%, RSI≤30 dump context, or BB lower+expanding width.
# Never cover red: close only when short PnL ≥ MIN_TAKE_PROFIT + FEE_BUFFER (~7%).
# Live requires BOTH CRASH_MODE=live AND CRASH_LIVE_ENABLED=true.
CRASH_ENABLED=true
CRASH_MODE=paper
CRASH_LIVE_ENABLED=false
CRASH_SQLITE_PATH=./data/snowball_crash.db
CRASH_BANKROLL_USD=1000
CRASH_MAX_POSITIONS=1
CRASH_MAX_NOTIONAL_USD=4000
CRASH_DAILY_LOSS_KILL_USD=25
# Max fraction of total Coinbase account value Crash Guard may use (50/50 products)
CRASH_ACCOUNT_BUDGET_PCT=0.10
CRASH_PRODUCTS=US5-19DEC30-CDE,TEK-19DEC30-CDE
CRASH_POLL_SECONDS=60

# --- Live keys (ignored in paper). Trade permission, NO withdraw, IP restrict. ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# --- Fed Desk (CME FedWatch research + FOMC skew bets; dual-gated live) ---
# Official source (Watcher + Fed research): CME FedWatch Tool
# https://www.cmegroup.com/markets/interest-rates/cme-fedwatch-tool.html
# Probabilities via cme-fedwatch package (not HTML scrape). Watcher logs research-only.
# Live requires BOTH FED_MODE=live AND FED_LIVE_ENABLED=true.
FED_ENABLED=true
FED_MODE=paper
FED_LIVE_ENABLED=false
FED_SQLITE_PATH=./data/snowball_fed.db
FED_BANKROLL_USD=1000
FED_MAX_POSITIONS=1
FED_MAX_NOTIONAL_USD=4000
FED_DAILY_LOSS_KILL_USD=25
# 5% of account value (50/50 SPY/QQQ)
FED_ACCOUNT_BUDGET_PCT=0.05
FED_PRODUCTS=US5-19DEC30-CDE,TEK-19DEC30-CDE
FED_POLL_SECONDS=60
# FedWatch research cadence (seconds); default 3h
FED_RESEARCH_POLL_SECONDS=10800
